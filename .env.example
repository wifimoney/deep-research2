OPENAI_API_KEY="your-openai-api-key"
EXASEARCH_API_KEY="your-exa-api-key"

# RAG configuration
VECTOR_DB_URL="file:../breach-intel-vectors.db"
EMBEDDINGS_MODEL="text-embedding-3-small"
# Optional: override embedding dimensions and retrieval
# EMBEDDINGS_DIMENSIONS=1536
# RAG_TOP_K=5
# RAG_MIN_SCORE=0

# RAG configuration
VECTOR_DB_URL="file:../breach-intel-vectors.db"
EMBEDDINGS_MODEL="text-embedding-3-small"
EMBEDDINGS_DIMENSIONS="1536"
RAG_TOP_K="5"
RAG_MIN_SCORE="0"

# Authentication & Server Configuration
# BASE_URL is CRITICAL for OAuth to work correctly in production
# This must match the domain registered in Google OAuth Console
# Local development: http://localhost:3000
# Production: https://your-production-domain.com
BASE_URL="http://localhost:3000"

# Google OAuth Configuration
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
BETTER_AUTH_SECRET="your-secret-key-change-in-production"
